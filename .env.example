# Web (Vercel). Exposed to the browser, never put secrets here.
VITE_LUMINA_API_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Render only; configure these in the Render dashboard, not Vercel.
# DATABASE_URL=postgresql://...
# LUMINA_API_ALLOWED_ORIGINS=https://YOUR-VERCEL-PROJECT.vercel.app
# Render Free uses ephemeral local storage for uploaded files.
# LUMINA_API_STORAGE=lumina-files
# Optional per-user quota in bytes; 0 disables the quota.
# LUMINA_MAX_USER_BYTES=524288000
# Optional S3-compatible persistent file storage (Cloudflare R2, Supabase, Backblaze B2).
# LUMINA_S3_BUCKET=lumina-files
# LUMINA_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# LUMINA_S3_REGION=auto
# LUMINA_S3_ACCESS_KEY_ID=...
# LUMINA_S3_SECRET_ACCESS_KEY=...
